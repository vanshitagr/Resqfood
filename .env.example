# Copy to .env and fill in. Everything here is OPTIONAL for local development except
# JWT_SECRET, which is mandatory in production. The app runs with no .env at all.

# ---- core -------------------------------------------------------------------
PORT=3000
NODE_ENV=development
# REQUIRED in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# ---- database ----------------------------------------------------------------
# Leave DATABASE_URL blank to use the local SQLite file (zero setup, good for demos).
# Set it to a Postgres/Supabase connection string to use that instead - the schema is
# created automatically on first start. Verify either mode with: npm run db:check
#
# Supabase: dashboard -> Connect -> Session pooler (NOT the direct db.<ref>.supabase.co
# host, which is IPv6-only and unreachable from most networks/hosts).
# Percent-encode the password if it contains @ : / ? # or %.
DATABASE_URL=
DATABASE_POOL_MAX=8
# Set to 1 to require a verifiable TLS certificate chain (needs the provider CA installed).
DATABASE_SSL_STRICT=
# SQLite file location, used only when DATABASE_URL is blank. :memory: for a throwaway DB.
DB_PATH=./data/app.db

# ---- Google sign-in (optional) ----------------------------------------------
# Leave blank to disable: the button is hidden and password login keeps working.
# Create credentials at https://console.cloud.google.com/apis/credentials
#   Application type: Web application
#   Authorised redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only needed if the public URL differs from the request host (proxy, custom domain).
# Must match the Google console entry byte for byte.
GOOGLE_REDIRECT_URI=

# ---- optional AI donation assistant -----------------------------------------
# Without a key the natural-language parser falls back to local rules; donations still work.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ---- optional outbound notifications ----------------------------------------
# All optional. In-app notifications always work; these only add extra delivery on top.
# Severity decides the mix: INFO stays in-app + push, URGENT also emails and texts
# (no match found, pickup due, expiring soon, expired).

# Push / generic webhook - forward to any push service, Slack bridge or internal queue.
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_TOKEN=

# Email. EMAIL_PROVIDER is 'resend' (default) or 'sendgrid'. Both are plain HTTPS calls.
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=

# SMS via Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Used to build deep links inside emails, e.g. https://your-domain.example
PUBLIC_URL=
APP_NAME=ResQFood

# ---- geocoding ---------------------------------------------------------------
# Set to 0 to skip the OpenStreetMap lookup and use only the built-in offline city table.
GEOCODE_ONLINE=1

# ---- CORS --------------------------------------------------------------------
# Comma-separated origins allowed to call the API cross-site. Leave blank (default) when
# the UI is served from this same server - then no cross-origin access is granted at all.
CORS_ORIGINS=

# ---- matching engine tuning (see server/config.js) ---------------------------
# Score weights; should total 100.
WEIGHT_DISTANCE=30
WEIGHT_CAPACITY=25
WEIGHT_PREFERENCE=20
WEIGHT_URGENCY=25
MAX_MATCH_KM=40
MAX_SCORE_KM=25
SAFETY_BUFFER_MIN=30
AVG_SPEED_KMH=28
MAX_ACTIVE_PER_DRIVER=2

# ---- auth rate limiting ------------------------------------------------------
LOGIN_ATTEMPTS=25
LOGIN_WINDOW_MIN=15

# ---- expiry handling ---------------------------------------------------------
EXPIRY_HIGH_RISK_MIN=60
EXPIRY_MEDIUM_RISK_MIN=180
EXPIRY_WARN_MIN=45
PICKUP_REMINDER_MIN=90
MAX_EXPIRY_HOURS=168
SWEEP_INTERVAL_MS=60000

# ---- impact estimation methodology -------------------------------------------
# kg of CO2e avoided per kg of food rescued, and litres of water per kg.
# Both are documented estimates, surfaced in the dashboard's "How this is calculated".
CO2E_KG_PER_KG_FOOD=2.5
WATER_L_PER_KG_FOOD=1000
