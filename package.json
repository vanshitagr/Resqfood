{
  "name": "surplus-to-shelter",
  "version": "1.0.0",
  "description": "AmiHacks Track A - real-time food rescue routing",
  "main": "server/index.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.js",
    "seed": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/seed.js",
    "test": "node --disable-warning=ExperimentalWarning --test tests/e2e.test.js tests/dialect.test.js",
    "test:ui": "node tests/ui-smoke.js",
    "check": "node --check server/index.js && node --check public/app.js && node -e \"require('./server/app');console.log('server modules load OK')\"",
    "db:check": "node scripts/check-db.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "puppeteer-core": "^25.12.0"
  },
  "license": "MIT"
}
