PORT=3000
# Required in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Optional: enables the AI donation assistant (falls back to a rule-based parser without it)
ANTHROPIC_API_KEY=
# Set to 0 to disable online geocoding (uses built-in city table)
GEOCODE_ONLINE=1
